{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "bin/**",
    "node_modules/**",
    "native/prelude.js"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "node"
  ],
  "jsPlugins": [
    {
      "name": "pi-moejs",
      "specifier": "./lint/oxlint-plugin.mjs"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "pi-moejs/no-comments": "error"
  }
}
